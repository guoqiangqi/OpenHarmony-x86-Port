+// WLOGE goes through the silent HiLogPrint stub; mirror loader failures to the
+// kernel console so bring-up can see which dlopen/entry-point failed.
+static void LoaderKmsg(const char *what, const char *name)
+{
+    int fd = open("/dev/kmsg", O_WRONLY);
+    if (fd >= 0) {
+        char buf[256];
+        const char *err = dlerror();
+        (void)snprintf(buf, sizeof(buf), "EGL61LOADER[%d]: %s %s failed: %s\n",
+            getpid(), what, name, (err != nullptr) ? err : "no dlerror");
+        (void)write(fd, buf, strlen(buf));
+        (void)close(fd);
+    }
+}
+
