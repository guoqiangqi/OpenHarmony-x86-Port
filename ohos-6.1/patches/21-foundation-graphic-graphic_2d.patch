+// Fallback definition of the only hilog symbol referenced by this library.
+// In appspawn sandboxed processes libhilog.so can be loaded RTLD_LOCAL and
+// invisible when this library is relocated, so the HiLogPrint JUMP_SLOT is
+// deferred by the lazy path and keeps its link-time value; the first call
+// then jumps to an unmapped address and crashes the process. A local strong
+// symbol keeps the call in-process. Kept minimal on purpose: hilog-style
+// "%{public}s" format strings are not safe to feed to plain vsnprintf.
+extern "C" int HiLogPrint(LogType type, LogLevel level, unsigned int domain,
+    const char *tag, const char *fmt, ...)
+{
+    (void)type;
+    (void)level;
+    (void)domain;
+    (void)tag;
+    (void)fmt;
+    return 0;
+}
