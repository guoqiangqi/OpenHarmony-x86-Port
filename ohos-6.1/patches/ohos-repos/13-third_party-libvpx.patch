diff --git a/BUILD.gn b/BUILD.gn
index c9e15cb9b..4ac5dcea3 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -18,6 +18,9 @@ declare_args() {
   enable_share = 1
   enable_static = 0
   enable_neon = true
+  if (target_cpu == "x86_64" || target_cpu == "x64") {
+    enable_neon = false
+  }
   enable_avx512 = 0
   enable_hbd = true
 }
@@ -244,6 +247,8 @@ ohos_shared_library("vpxdec_ohos") {
   ]
   if (target_cpu =="arm64") {
     include_dirs += ["./armv8_config"]
+  } else if (target_cpu == "x86_64" || target_cpu == "x64") {
+    # x86 config + rtcd come from $target_gen_dir (generated by build.sh)
   } else {
     include_dirs += ["./armv7_config"]
   }
diff --git a/build.sh b/build.sh
index 442163704..78418bdfe 100755
--- a/build.sh
+++ b/build.sh
@@ -37,6 +37,27 @@ if [ "$CPU" == "arm64" ]; then
       --disable-sve
 fi
 
+if [ "$CPU" == "x86_64" ]; then
+  ./configure \
+      --target=x86_64-linux-gcc \
+      --enable-vp9-highbitdepth \
+      --disable-vp8-encoder \
+      --disable-vp9-encoder \
+      --disable-unit-tests   \
+      --disable-examples \
+      --disable-libyuv  \
+      --disable-webm-io  \
+      --disable-avx512 \
+      --disable-mmx --disable-sse --disable-sse2 --disable-sse3 \
+      --disable-ssse3 --disable-sse4-1 --disable-avx --disable-avx2 \
+      --disable-runtime-cpu-detect \
+      --disable-postproc
+  # rtcd headers (SSE2/MMX variants) are produced by the make rtcd target
+  make rtcd -j$(nproc) >/dev/null 2>&1 || true
+  cp vpx_config.h vpx_config.c vpx_dsp_rtcd.h vpx_scale_rtcd.h vp8_rtcd.h vp9_rtcd.h "$OUTPUT_DIR/" 2>/dev/null
+  make distclean >/dev/null 2>&1 || true
+fi
+
 if [ "$CPU" == "arm" ]; then
   ./configure \
       --target=armv7-linux-gcc  \
@@ -52,7 +73,8 @@ if [ "$CPU" == "arm" ]; then
       --disable-neon
 fi
 
-sed -i 's/#define HAVE_NEON[[:space:]]*0/#define HAVE_NEON 1/' vpx_config.h
+if [ "$CPU" != "x86_64" ]; then
+  sed -i 's/#define HAVE_NEON[[:space:]]*0/#define HAVE_NEON 1/' vpx_config.h
 sed -i 's/#define CONFIG_INSTALL_DOCS[[:space:]]*1/#define CONFIG_INSTALL_DOCS 0/' vpx_config.h
 sed -i 's/#define HAVE_NEON_DOTPROD[[:space:]]*1/#define HAVE_NEON_DOTPROD 0/' vpx_config.h
 sed -i 's/#define HAVE_NEON_I8MM[[:space:]]*1/#define HAVE_NEON_I8MM 0/' vpx_config.h
@@ -63,4 +85,5 @@ sed -i 's/#define CONFIG_MULTITHREAD[[:space:]]*0/#define CONFIG_MULTITHREAD 1/'
 sed -i 's/#define CONFIG_RUNTIME_CPU_DETECT[[:space:]]*1/#define CONFIG_RUNTIME_CPU_DETECT 0/' vpx_config.h
 
 cp vpx_config.h "$OUTPUT_DIR/"
+fi
 rm -f vpx_config.h
