+// Mirror incoming full-screen client layer buffers into the kernel fbdev
+// (/dev/fb1) via write(). The fbdev deferred-io path reliably reaches the host
+// scanout on this virtio-gpu setup, so the UI becomes visible on the virtual
+// display even though direct dumb-buffer scanout of imported gralloc buffers
+// does not.
+static void MirrorToFramebuffer(const BufferHandle *buffer)
+{
+    static int fbFd = -1;
+    static uint32_t fbW = 0;
+    static uint32_t fbH = 0;
+    static uint32_t fbStride = 0;
+    static uint32_t mirrorCount = 0;
+
+    if (buffer == nullptr || buffer->width < 1024 || buffer->stride <= 0) {
+        return;
+    }
+    if (fbFd < 0) {
+        if (access("/data/hdi_mirror", F_OK) != 0) {
+            return;
+        }
+        fbFd = open("/dev/fb1", O_WRONLY);
+        if (fbFd < 0) {
+            if (errno == EACCES || errno == ENOENT) {
+                static bool logged = false;
+                if (!logged) {
+                    DISPLAY_LOGE("mirror: open /dev/fb1 failed errno %{public}d", errno);
+                    logged = true;
+                }
+            }
+            return;
+        }
+        struct fb_var_screeninfo vinfo;
+        struct fb_fix_screeninfo finfo;
+        if (ioctl(fbFd, FBIOGET_VSCREENINFO, &vinfo) < 0 ||
+            ioctl(fbFd, FBIOGET_FSCREENINFO, &finfo) < 0) {
+            DISPLAY_LOGE("mirror: fb ioctl failed errno %{public}d", errno);
+            close(fbFd);
+            fbFd = -1;
+            return;
+        }
+        fbW = vinfo.xres;
+        fbH = vinfo.yres;
+        fbStride = finfo.line_length;
+        DISPLAY_LOGI("mirror: fb1 %{public}ux%{public}u stride %{public}u enabled", fbW, fbH, fbStride);
+    }
+    if (fbW == 0 || fbH == 0) {
+        return;
+    }
+    if (g_buffer == nullptr) {
+        IDisplayBufferVdi* dispBuf = new DisplayBufferVdiImpl();
+        g_buffer.reset(dispBuf);
+    }
+    void *src = g_buffer->Mmap(*const_cast<BufferHandle *>(buffer));
+    if (src == nullptr) {
+        return;
+    }
+    uint32_t copyH = std::min(static_cast<uint32_t>(buffer->height), fbH);
+    uint32_t copyWbytes = std::min(static_cast<uint32_t>(buffer->width) * 4u, fbStride);
+    const uint8_t *from = static_cast<const uint8_t *>(src);
+    if (copyWbytes == fbStride && buffer->stride == static_cast<int32_t>(fbStride)) {
+        // fast path: identical layout, single write
+        ssize_t wr = write(fbFd, from, static_cast<size_t>(copyH) * fbStride);
+        (void)wr;
+    } else {
+        for (uint32_t y = 0; y < copyH; y++) {
+            ssize_t wr = pwrite(fbFd, from + static_cast<size_t>(y) * buffer->stride,
+                copyWbytes, static_cast<off_t>(y) * fbStride);
+            (void)wr;
+        }
+    }
+    g_buffer->Unmap(*const_cast<BufferHandle *>(buffer));
+    mirrorCount++;
+    if ((mirrorCount & 0x1F) == 1) { // every 32 frames
+        DISPLAY_LOGI("mirror: wrote frame #%{public}u", mirrorCount);
+    }
+    // Poke the vt console so fbcon redraws (full-screen scroll damage). That
+    // damage is what actually pushes the shadow fb content, including the
+    // mirrored UI, through drm_fb_helper to the real scanout on this stack.
+    static int conFd = -1;
+    if (conFd < 0) {
+        conFd = open("/dev/console", O_WRONLY);
+    }
+    if (conFd >= 0) {
+        ssize_t w = write(conFd, "\n", 1);
+        (void)w;
+    }
+}
