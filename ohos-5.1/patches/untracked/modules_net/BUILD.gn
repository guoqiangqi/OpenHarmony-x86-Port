import("//build/ohos.gni")

# QEMU e1000 NIC module (built from the same kernel tree/toolchain as the
# bzImage, vermagic 6.6.86). Loaded by /vendor/etc/init/zz_net_setup.cfg
# (post-fs-data) together with eth0 static address setup, so hdc over
# hostfwd works with zero manual injection.
net_modules = [
    "e1000.ko",
]

net_modules_deps = []
foreach(name, net_modules) {
    ohos_prebuilt_etc("${name}") {
        source = "${name}"
        install_enable = true
        install_images = [ system_base_dir ]
        module_install_dir = "lib/modules"
        part_name = "device_x86_general"
    }
    net_modules_deps += [ ":${name}" ]
}

group("modules_net_group") {
    deps = net_modules_deps
}
