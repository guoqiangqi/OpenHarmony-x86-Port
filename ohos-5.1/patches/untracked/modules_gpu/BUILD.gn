import("//build/ohos.gni")

# QEMU virtio-gpu display modules (built from the same kernel tree/toolchain as
# the bzImage, vermagic 6.6.86). Loaded in order by init.x86_general.cfg:
# virtio_dma_buf -> drm_shmem_helper -> virtio-gpu (dependency chain).
# Keep the .ko files in sync when the kernel config changes.
gpu_modules = [
    "virtio_dma_buf.ko",
    "drm_shmem_helper.ko",
    "virtio-gpu.ko",
]

modules_deps = []
foreach(name, gpu_modules) {
    ohos_prebuilt_etc("${name}") {
        source = "${name}"
        install_enable = true
        install_images = [ system_base_dir ]
        module_install_dir = "lib/modules"
        part_name = "device_x86_general"
    }
    modules_deps += [ ":${name}" ]
}

group("modules_gpu_group") {
    deps = modules_deps
}
