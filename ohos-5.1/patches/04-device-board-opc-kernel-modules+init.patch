diff --git a/x86_general/cfg/BUILD.gn b/x86_general/cfg/BUILD.gn
index 18498c1..4e7ec8a 100644
--- a/x86_general/cfg/BUILD.gn
+++ b/x86_general/cfg/BUILD.gn
@@ -33,10 +33,22 @@ ohos_prebuilt_etc("fstab.x86_general") {
   install_enable = true
 }
 
+# Network & device nodes setup (e1000 + fb0/hdf mknod + eth0 static addr).
+# Installed into /vendor/etc/init/ which is scanned by init (init_config.c),
+# so cmds are merged into the post-fs-data job at boot.
+ohos_prebuilt_etc("zz_net_setup.cfg") {
+  source = "zz_net_setup.cfg"
+  part_name = "device_x86_general"
+  install_images = [ vendor_base_dir ]
+  module_install_dir = "etc/init"
+  install_enable = true
+}
+
 group("init_configs") {
   deps = [
     ":fstab.x86_general",
     ":init.x86_general.cfg",
     ":init.x86_general.usb.cfg",
+    ":zz_net_setup.cfg",
   ]
 }
