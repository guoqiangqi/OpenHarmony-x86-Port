diff --git a/x86_general/kernel/build_kernel.sh b/x86_general/kernel/build_kernel.sh
index 17f368f..7eac0cc 100755
--- a/x86_general/kernel/build_kernel.sh
+++ b/x86_general/kernel/build_kernel.sh
@@ -159,9 +159,24 @@ MAKE="make LLVM=1 LLVM_IAS=1 "
 
 ${MAKE} ${DEFCONFIG_FILE}
 ${MAKE} bzImage -j$(nproc)
-#编译ko模式（未启用）
-# ${MAKE} modules -j$(nproc)
-# ${MAKE} modules_install
+#编译ko模式（已启用）：与 bzImage 同源构建板级所需模块，避免内核小版本升级后 vermagic 失配
+#注：不做全量 make modules——此内核树 f2fs/dwc3 的 modpost 符号不一致（上游补丁残留）会全量失败；
+#单目标编译可绕过全局 MODPOST，且只编镜像实际需要的 4 个模块
+#三个 GPU 模块有依赖链（virtio-gpu → drm_shmem_helper → virtio_dma_buf），
+#必须同一 make 调用联编，否则 MODPOST 批次内解析不到依赖符号而报 undefined
+${MAKE} drivers/virtio/virtio_dma_buf.ko drivers/gpu/drm/drm_shmem_helper.ko drivers/gpu/drm/virtio/virtio-gpu.ko -j$(nproc)
+${MAKE} drivers/net/ethernet/intel/e1000/e1000.ko -j$(nproc)
+#同步关键 ko 到板级 prebuilt 源目录（modules_gpu/modules_net 由 ohos_prebuilt_etc 装入镜像）
+#注：GN 增量构建时 prebuilt 拷贝与内核编译不保证先后，若 vermagic 变化请重跑一次构建
+KO_DST_GPU=${ROOT_DIR}/device/board/${PRODUCT_COMPANY}/${DEVICE_NAME}/modules_gpu
+KO_DST_NET=${ROOT_DIR}/device/board/${PRODUCT_COMPANY}/${DEVICE_NAME}/modules_net
+mkdir -p ${KO_DST_GPU} ${KO_DST_NET}
+cp -f ${KERNEL_OBJ_TMP_PATH}/drivers/virtio/virtio_dma_buf.ko ${KO_DST_GPU}/
+cp -f ${KERNEL_OBJ_TMP_PATH}/drivers/gpu/drm/drm_shmem_helper.ko ${KO_DST_GPU}/
+cp -f ${KERNEL_OBJ_TMP_PATH}/drivers/gpu/drm/virtio/virtio-gpu.ko ${KO_DST_GPU}/
+cp -f ${KERNEL_OBJ_TMP_PATH}/drivers/net/ethernet/intel/e1000/e1000.ko ${KO_DST_NET}/
+echo "synced kernel modules (vermagic check):"
+md5sum ${KO_DST_GPU}/virtio_dma_buf.ko ${KO_DST_GPU}/drm_shmem_helper.ko ${KO_DST_GPU}/virtio-gpu.ko ${KO_DST_NET}/e1000.ko
 
 mkdir -p ${OUT_PKG_DIR}
 
