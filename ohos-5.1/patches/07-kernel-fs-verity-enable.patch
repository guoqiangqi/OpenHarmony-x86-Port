--- /dev/null
+++ b/fs/verity/sysfs.c
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * fs/verity/sysfs.c: sysfs interface for fs-verity
+ *
+ * Minimal backport of the upstream (6.15) /sys/fs/verity interface for the
+ * 6.6 OHOS kernel: some userspace components (bundle code-signature tooling)
+ * probe this directory to decide whether fs-verity is available. The actual
+ * kernel-level detection used by OHOS 5.1 code_signature is the statx
+ * STATX_ATTR_VERITY mask, which does not depend on this file.
+ */
+#include "fsverity_private.h"
+
+#include <linux/sysfs.h>
+
+static struct kobject *fsverity_kobj;
+
+static ssize_t features_show(struct kobject *kobj,
+			     struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "verity\n");
+}
+
+static struct kobj_attribute features_attr = __ATTR_RO(features);
+
+static struct attribute *fsverity_attrs[] = {
+	&features_attr.attr,
+	NULL
+};
+
+ATTRIBUTE_GROUPS(fsverity);
+
+void __init fsverity_init_sysfs(void)
+{
+	fsverity_kobj = kobject_create_and_add("verity", fs_kobj);
+	if (!fsverity_kobj)
+		panic("fsverity: failed to create /sys/fs/verity\n");
+
+	if (sysfs_create_groups(fsverity_kobj, fsverity_groups))
+		panic("fsverity: failed to create sysfs group\n");
+}
